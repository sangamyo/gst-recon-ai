# Copy to .env for local development. Never commit the real .env.

# "production" enables strict checks (a strong GSTRECON_SECRET_KEY is required).
ENV=development

# JWT signing key. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GSTRECON_SECRET_KEY=

# SQLAlchemy URL. postgres:// and postgresql:// (Railway style) are accepted.
# Defaults to sqlite:///./gstrecon.db when unset.
DATABASE_URL=sqlite:///./gstrecon.db
# DATABASE_URL=postgresql://gstrecon:gstrecon@localhost:5432/gstrecon

# Optional. When set, jobs are queued to Celery (run a worker). When empty, jobs run in-process.
REDIS_URL=
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Comma-separated list of allowed browser origins (your Vercel URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex, e.g. https://.*\.vercel\.app to allow preview deployments.
# CORS_ORIGIN_REGEX=

# Where uploaded workbooks and generated reports are stored.
STORAGE_DIR=./storage

# Allow choosing the "admin" role on self-registration (keep false on public deployments).
ALLOW_ADMIN_SIGNUP=false

# JWT_EXPIRATION_MINUTES=720
